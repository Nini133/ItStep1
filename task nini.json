			"name": "Genderize",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"",
							"pm.test(\"Status is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"let data = pm.response.json();",
							"",
							"pm.test(\"Gender is valid\", function () {",
							"    pm.expect([\"male\", \"female\"]).to.include(data.gender);",
							"});",
							"",
							"pm.variables.set(\"gender\", data.gender);",
							"pm.variables.set(\"person_name\", data.name);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
