			"name": "Dadjoke",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.headers.get('Content-Type').includes('application/json')) {",
							"    let data = pm.response.json();",
							"",
							"    pm.test(\"joke is valid\", function () {",
							"        pm.expect(data.joke).to.be.a(\"string\").and.not.empty;",
							"    });",
							"",
							"    pm.variables.set(\"joke\", data.joke);",
							"",
							"    let finalObject = {",
							"        name: pm.variables.get(\"person_name\"),",
							"        gender: pm.variables.get(\"gender\"),",
							"        age: pm.variables.get(\"age\"),",
							"        country: pm.variables.get(\"country\"),",
							"        dad_joke: pm.variables.get(\"joke\")",
							"    };",
							"",
							"    console.log(finalObject);",
							"} else {",
							"    console.log(\"Response is not JSON, it's HTML or another format.\");",
							"    console.log(pm.response.text());  // This will log the HTML content for debugging.",
							"}",
